# Supabase配置
# 1. 访问 https://supabase.com 注册账号
# 2. 创建新项目
# 3. 在 Settings > API 中找到以下信息
VITE_SUPABASE_URL=https://pthfvgqeojqaujpbxnem.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API配置（已有）
GEMINI_API_KEY=your-gemini-api-key

# 以太坊配置
# 部署合约的私钥（请勿泄露！）
PRIVATE_KEY=your-ethereum-private-key

# RPC节点配置
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://eth.llamarpc.com

# Etherscan API Key（用于验证合约）
ETHERSCAN_API_KEY=your-etherscan-api-key

# 合约地址（部署后填写）
VITE_SPARK_TOKEN_ADDRESS=
VITE_MINT_CONTROLLER_ADDRESS=
VITE_MEMBERSHIP_MANAGER_ADDRESS=
VITE_REWARD_POOL_ADDRESS=

# USDT合约地址
# Mainnet: 0xdAC17F958D2ee523a2206206994597C13D831ec7
# Sepolia: 需要部署测试USDT
VITE_USDT_ADDRESS=
