  "scoring_criteria": {
    "relevance": {
      "weight": 0.35,
      "max_score": 35,
      "description": "Content relevance to AI topics",
      "levels": {
        "excellent": "31-35: Highly relevant AI content with specific technical discussions",
        "good": "21-30: Strong AI relevance with clear topic focus",
        "fair": "11-20: Partially relevant with some AI-related content",
        "poor": "0-10: Minimal or no AI relevance"
      }
    },
    "quality": {
      "weight": 0.35,
      "max_score": 35,
      "description": "Overall content quality and clarity",
      "levels": {
        "excellent": "31-35: Clear logic, accurate expression, complete structure",
        "good": "21-30: Good quality with minor issues",
        "fair": "11-20: Average quality with some flaws",
        "poor": "0-10: Poor quality with significant issues"
      }
    },
    "value": {
      "weight": 0.30,
      "max_score": 30,
      "description": "Educational and practical value for readers",
      "levels": {
        "high": "21-30: High value with actionable insights",
        "medium": "11-20: Moderate value with some useful information",
        "low": "0-10: Limited value or usefulness"
      }
    }
