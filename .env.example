# Supabase 配置
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 仅后端使用

# 区块链配置
# 生产环境使用 Base 主网
VITE_RPC_URL=https://mainnet.base.org
VITE_CHAIN_ID=8453

# 如需使用测试网，取消注释以下配置
# VITE_RPC_URL=https://sepolia.base.org
# VITE_CHAIN_ID=84532

# 合约地址
VITE_SPARK_TOKEN_ADDRESS=
VITE_USDT_ADDRESS=
VITE_MINT_CONTROLLER_ADDRESS=
VITE_MEMBERSHIP_MANAGER_ADDRESS=
VITE_REWARD_POOL_ADDRESS=
VITE_POST_SCORING_AGENT_ADDRESS=

# Owner钱包私钥（仅后端服务使用，非常重要！不要泄露！）
OWNER_PRIVATE_KEY=  # 0x开头的私钥，只用于后端同步服务

# Mint配置
VITE_MINT_COST_ETH=0.003
VITE_MINT_REWARD_SPARK=10000
VITE_MINT_ELIGIBLE_USERS=2000

# 会员配置
VITE_MEMBERSHIP_COST_USDT=10
VITE_MEMBERSHIP_DURATION_DAYS=30

# 周排名配置
VITE_WEEKLY_REWARD_RANK_1=10000
VITE_WEEKLY_REWARD_RANK_10=2000
VITE_WEEKLY_REWARD_DECREASE=889

# AI Agent配置
VITE_AGENT_METADATA_URI=https://your-domain.com/agent-metadata.json
VITE_MIN_PASSING_SCORE=60
VITE_SCORING_ENABLED=true

# OpenAI API (用于AI评分和分类)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxx

# 告警通知（可选）
DISCORD_WEBHOOK_URL=  # Discord Webhook用于接收告警
TELEGRAM_BOT_TOKEN=   # Telegram Bot用于接收告警
TELEGRAM_CHAT_ID=     # Telegram Chat ID

# 开发模式
NODE_ENV=development

# ==============================================
# API 服务配置
# ==============================================

# API 服务端口（后端）
API_PORT=3100

# API 服务地址（前端调用）
# 本地开发: http://localhost:3100
# 生产环境: https://api.yourdomain.com
VITE_API_URL=http://localhost:3100
