{
  "name": "ai-spark---ai-wisdom-sharing-hub",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node backend-api.js",
    "start": "concurrently \"npm run api\" \"npm run dev\" --names \"API,WEB\" --prefix-colors \"blue,green\"",
    "sync:batch": "tsx scripts/batch-grant-eligibility.ts",
    "sync:once": "tsx scripts/sync-eligibility.ts",
    "sync:service": "tsx scripts/start-sync-service.ts",
    "hardhat:compile": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "hardhat:test": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "hardhat:deploy": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts",
    "hardhat:deploy:base-sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network baseSepolia",
    "hardhat:deploy:base": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network base",
    "agent:deploy": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deployAgent.ts",
    "agent:deploy:localhost": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deployAgent.ts --network localhost",
    "agent:deploy:base-sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deployAgent.ts --network baseSepolia",
    "agent:deploy:base": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deployAgent.ts --network base",
    "agent:register": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/registerToERC8004.ts --network localhost",
    "agent:register:base-sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/registerToERC8004.ts --network baseSepolia",
    "agent:register:base": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/registerToERC8004.ts --network base",
    "agent:query": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/queryAgentId.ts --network base"
  },
  "dependencies": {
    "@google/genai": "^1.39.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tanstack/react-query": "^5.90.20",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.563.0",
    "openai": "^6.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "viem": "^2.45.1",
    "wagmi": "^3.4.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "ethers": "^6.13.0",
    "hardhat": "^2.28.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
